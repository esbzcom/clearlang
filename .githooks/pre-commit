#!/usr/bin/env bash
set -euo pipefail

echo "[pre-commit] Running checks (set SKIP_PRECOMMIT=1 to skip all)"

if [[ "${SKIP_PRECOMMIT:-}" == "1" ]]; then
  echo "[pre-commit] Skipped by SKIP_PRECOMMIT=1"
  exit 0
fi

if ! command -v cargo >/dev/null 2>&1; then
  echo "[pre-commit] cargo not found; skipping Rust checks"
  exit 0
fi

# Optional: formatting
if [[ "${SKIP_FMT:-}" != "1" ]]; then
  echo "[pre-commit] cargo fmt --all -- --check"
  cargo fmt --all -- --check
else
  echo "[pre-commit] Skipping fmt (SKIP_FMT=1)"
fi

# Optional: clippy
if [[ "${SKIP_CLIPPY:-}" != "1" ]]; then
  echo "[pre-commit] cargo clippy --workspace --all-targets -- -D warnings"
  cargo clippy --workspace --all-targets -- -D warnings
else
  echo "[pre-commit] Skipping clippy (SKIP_CLIPPY=1)"
fi

# Tests
if [[ "${SKIP_TESTS:-}" != "1" ]]; then
  echo "[pre-commit] cargo test --workspace"
  cargo test --workspace
else
  echo "[pre-commit] Skipping tests (SKIP_TESTS=1)"
fi

echo "[pre-commit] OK"
exit 0

